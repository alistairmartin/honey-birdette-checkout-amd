// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  // Local dev: file:dev.sqlite (set in .env). Production (Render): an absolute
  // path on the mounted persistent disk, e.g. file:/data/prod.sqlite.
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per Shopify order that the reconciliation sweep found missing in Kibo.
// Sweeps upsert on (shop, shopifyOrderId), so re-running never duplicates a row.
// status: PENDING | EXISTS_IN_KIBO | REIMPORTED | REIMPORT_FAILED | IGNORED
model KiboFailedOrder {
  id               String   @id @default(cuid())
  shop             String
  shopifyOrderId   String
  shopifyOrderName String
  orderCreatedAt   DateTime
  detectedAt       DateTime @default(now())
  lastCheckedAt    DateTime @default(now())
  reason           String
  suggestion       String
  status           String   @default("PENDING")
  kiboOrderId      String?
  attempts         Int      @default(0)
  lastError        String?

  @@unique([shop, shopifyOrderId])
  @@index([shop, status])
}

// One row per template-copy run started from the Template copier page
// (app/routes/app.template-copier.jsx). A run copies N template files from one
// source shop/theme into one destination shop/theme, so a copy to three stores
// writes three rows sharing a `batchId` - that's what the history groups on.
// `filesJson` is the stringified array of per-file results
// ([{ filename, status, error }]), kept so the page can show exactly what landed.
// status: SUCCESS | PARTIAL | FAILED
model ThemeCopyLog {
  id              String   @id @default(cuid())
  // Shared by every row written by one press of the Copy button.
  batchId         String   @default("")
  // The store the app was open in when the copy ran. History and revert are
  // scoped to this, NOT to sourceShop - the source can be any store now, but the
  // copy still belongs to whoever was driving the app. Backfilled to sourceShop
  // for old rows via the default so pre-existing history still shows.
  embeddedShop    String   @default("")
  sourceShop      String
  sourceThemeId   String
  sourceThemeName String
  targetShop      String
  targetThemeId   String
  targetThemeName String
  targetThemeRole String
  fileCount       Int
  successCount    Int
  status          String
  filesJson       String
  // Per-image/video results ([{ filename, kind, status, error }]) when the run
  // also copied the media the templates reference into the destination's Files.
  imagesJson      String   @default("[]")
  // What the destination theme held for each of these filenames BEFORE the copy
  // ([{ filename, content }], content null when the copy created the file).
  // This is what Revert restores - without it, undoing means hunting through the
  // theme editor's version timeline by hand.
  previousJson    String   @default("[]")
  revertedAt      DateTime?
  error           String?
  copiedBy        String?
  createdAt       DateTime @default(now())

  @@index([sourceShop, createdAt])
  @@index([targetShop, createdAt])
  @@index([embeddedShop, createdAt])
  @@index([batchId])
}

// One row per saved Gift With Purchase config. The admin builder page writes
// these and, on every change, syncs the full set up to a shop metafield (read by
// the gift-with-purchase checkout extension) and the discount node metafield
// (read by the gift-with-purchase-discount function). `configJson` is the raw
// stringified config object.
model GwpAppV1Config {
  id         String   @id @default(cuid())
  shop       String
  name       String
  configJson String
  // GID of the automatic app discount this config owns (one discount per config,
  // each bound to the gift-with-purchase-discount function). Null until created.
  discountId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Webhook monitor (see WEBHOOK_MONITOR_HANDOFF.md). Observation only: the app
// records one row per webhook delivery Shopify sends it and never processes
// or forwards anything. No PII is stored - ids, timestamps, statuses, tags,
// counts and a fingerprint hash only.
// ---------------------------------------------------------------------------

// One row per webhook delivery this app receives.
model WebhookEvent {
  id                String   @id @default(cuid())
  shop              String
  // e.g. ORDERS_UPDATED (as returned by authenticate.webhook)
  topic             String
  // X-Shopify-Webhook-Id. Shopify retries with the same id, so unique dedupes.
  webhookId         String   @unique
  eventId           String?
  // order | customer | fulfillment | fulfillment_event | inventory_level
  resourceType      String
  // numeric id as a string (inventory: "<inventory_item_id>:<location_id>")
  resourceId        String
  // order name (#12345) or fulfillment name; null for customers/inventory
  resourceName      String?
  // Parent order id for orders, fulfillments and fulfillment events, so the
  // dashboard can deep-link every row to its order in admin.
  orderId           String?
  // X-Shopify-Triggered-At: when Shopify emitted it. receivedAt - triggeredAt
  // is the delivery lag.
  triggeredAt       DateTime?
  receivedAt        DateTime @default(now())
  // payload.updated_at
  resourceUpdatedAt DateTime?
  // See classify* in app/lib/webhookMonitor.server.js
  classification    String
  // sha1 of the fields that matter for this resource type
  fingerprint       String
  // Same fingerprint as the previous row for this resource = nothing a backend
  // cares about changed. This is the dashboard's "noise" count.
  repeatOfPrev      Boolean  @default(false)
  payloadBytes      Int
  // Best-effort origin guess: kibo | omneo | pos | youpay | shopify | unknown
  source            String?
  // The non-PII fingerprint inputs (statuses, counts, hashed contact fields)
  // as JSON, so the next row for the same resource can say WHAT changed.
  summaryJson       String   @default("{}")
  apiVersion        String?

  @@index([shop, receivedAt])
  @@index([shop, topic, receivedAt])
  @@index([shop, resourceType, resourceId, receivedAt])
}

// Optional: legacy backend queue depth, posted every minute by a cron on that
// server to /api/webhook-monitor/queue-depth.
model WebhookQueueSample {
  id        String   @id @default(cuid())
  shop      String
  files     Int
  // age of the oldest queued file in seconds
  oldestAge Int?
  sampledAt DateTime @default(now())

  @@index([shop, sampledAt])
}

// Hourly rollup of WebhookEvent so raw rows can be pruned after 3 days while
// the dashboard's 7 day window still works. Kept 90 days.
model WebhookHourly {
  id             String   @id @default(cuid())
  shop           String
  topic          String
  classification String
  hour           DateTime
  count          Int
  repeats        Int

  @@unique([shop, topic, classification, hour])
  @@index([shop, hour])
}

// Raw webhook bodies, gzip compressed, kept PAYLOAD_RETENTION_DAYS (3) so the
// monitor's bar drill-down can show a message exactly as Shopify sent it.
// This is the one place the monitor stores PII; the prune keeps it short.
model WebhookPayload {
  // Matches WebhookEvent.webhookId
  webhookId  String   @id
  shop       String
  receivedAt DateTime @default(now())
  // uncompressed size
  bytes      Int
  body       Bytes

  @@index([receivedAt])
}
